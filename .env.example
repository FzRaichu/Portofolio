# Copy to .env.local. Do not commit real credentials.
# Owner login: enter Ferciano on the landing page, then the configured password.
SESSION_SECRET=
AUTH_PASSWORD_HASH_B64=

# Upstash Redis: needed for persistent profile edits and the private inbox.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional email delivery. Without Redis, at least Resend must be configured
# for contact messages to be delivered. Use a verified sender in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
